      "lastName": "Agent",
      "credentials": [{ "type": "password", "value": "agent1", "temporary": false }],
      "realmRoles": ["AGENT"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@smartbank.local",
      "emailVerified": true,
