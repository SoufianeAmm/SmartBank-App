{
  "realm": "smartbank",
  "displayName": "SmartBank",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "CLIENT", "description": "Client de la banque (consulte ses comptes, fait des virements)" },
      { "name": "AGENT", "description": "Conseiller bancaire (crée clients et comptes, traite les crédits)" },
      { "name": "ADMIN", "description": "Administrateur (supervision, lancement des relevés batch)" }
    ]
  },
  "clients": [
    {
      "clientId": "smartbank-frontend",
      "name": "SmartBank Angular",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    }
  ],
  "users": [
    {
